  m_Name: ButcherDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u041C\u044F\u0441\u043D\u0438\u043A"
  dialogueLines:
  - "\u0412\u0438\u0436\u0443 \u0442\u044B \u043D\u0435 \u0438\u0437 \u044D\u0442\u0438\u0445
    \u043C\u0435\u0441\u0442. \u0418\u0449\u0435\u0448\u044C \u0437\u0434\u0435\u0441\u044C
    \u043B\u0435\u0433\u043A\u0438\u0445 \u0434\u0435\u043D\u0435\u0433?"
  - "10 \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u0437\u0430 \u0442\u0432\u0430\u0440\u044C
    \u0438\u0437 \u043B\u0435\u0441\u0430 \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A
    \u043D\u0435\u0445\u0438\u0442\u0440\u043E\u0435 \u0434\u0435\u043B\u043E. \u041E\u0434\u043D\u0430\u043A\u043E,
    \u043D\u0438\u0447\u0435\u0433\u043E \u043B\u0435\u0433\u043A\u043E\u0433\u043E
    \u0442\u0443\u0442 \u043D\u0435\u0442."
  - " \u0423\u0436\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u043E \u0443\u0448\u043B\u0438,
    \u0442\u0430\u043A \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C. "
